{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node"],
		"paths": {
			"pipewright": ["./src/index.ts"],
			"pipewright/*": ["./src/*/index.ts"]
		}
	},
	"include": ["src", "tests", "examples", "vitest.config.ts"]
}
