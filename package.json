{
	"name": "pipewright",
	"version": "0.1.0",
	"description": "Small typed workflow engine for TypeScript: sequential and DAG runners, Zod-validated nodes, approval gates, persistence and a node library",
	"keywords": [
		"workflow",
		"dag",
		"pipeline",
		"typescript",
		"zod",
		"orchestration",
		"human-in-the-loop"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/onblueroses/pipewright"
	},
	"homepage": "https://github.com/onblueroses/pipewright",
	"bugs": {
		"url": "https://github.com/onblueroses/pipewright/issues"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./nodes": {
			"types": "./dist/nodes/index.d.ts",
			"import": "./dist/nodes/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"pack:check": "npm pack --dry-run",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.20.5",
		"better-sqlite3": "^13.2.0",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"better-sqlite3": ">=12"
	},
	"peerDependenciesMeta": {
		"better-sqlite3": {
			"optional": true
		}
	}
}
