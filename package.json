{
	"name": "pipewright",
	"version": "0.1.0",
	"description": "Lightweight TypeScript workflow engine with typed nodes, sequential execution, and human-in-the-loop approval gates",
	"keywords": [
		"workflow",
		"pipeline",
		"typescript",
		"zod",
		"orchestration"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/onblueroses/pipewright"
	},
	"homepage": "https://github.com/onblueroses/pipewright",
	"bugs": {
		"url": "https://github.com/onblueroses/pipewright/issues"
	},
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"pack:check": "npm pack --dry-run",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/node": "^22.20.5",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
